# ctest driver: configure, build and run tests/byo_imgui.
#   -DSILTA_SOURCE -DIMGUI_DIR -DWORK_DIR -DCONFIG -DGENERATOR [-DPLATFORM]
file(REMOVE_RECURSE "${WORK_DIR}")
function(run)
  execute_process(COMMAND ${ARGV} RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Command failed (${result}): ${ARGV}\n${out}\n${err}")
  endif()
endfunction()
if(NOT CONFIG)
  set(CONFIG Release)
endif()
set(platform_args "")
if(PLATFORM)
  set(platform_args -A ${PLATFORM})
endif()
# Same MSVC runtime as the Silta build (static or DLL), or the link fails.
if(MSVC_RUNTIME)
  list(APPEND platform_args "-DCMAKE_MSVC_RUNTIME_LIBRARY=${MSVC_RUNTIME}")
endif()
run(${CMAKE_COMMAND} -S "${SILTA_SOURCE}/tests/byo_imgui" -B "${WORK_DIR}" -G "${GENERATOR}" ${platform_args}
    "-DSILTA_SOURCE=${SILTA_SOURCE}" "-DIMGUI_DIR=${IMGUI_DIR}" "-DCMAKE_BUILD_TYPE=${CONFIG}")
run(${CMAKE_COMMAND} --build "${WORK_DIR}" --config ${CONFIG} --target host)
foreach(candidate "${WORK_DIR}/${CONFIG}/host.exe" "${WORK_DIR}/host.exe" "${WORK_DIR}/host")
  if(EXISTS "${candidate}")
    set(exe "${candidate}")
    break()
  endif()
endforeach()
if(NOT exe)
  message(FATAL_ERROR "host executable not found in ${WORK_DIR}")
endif()
run("${exe}")
message(STATUS "Silta built against the host's ImGui")
