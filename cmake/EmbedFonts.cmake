# Turns the Inter font files into a C++ source with byte arrays, so the
# library carries its fonts and applications need no fonts/ folder.
#
#   silta_embed_fonts(<output.cpp> <font-dir>)
#
# The source is regenerated only when a font file changes.
function(silta_embed_fonts output font_dir)
  set(faces "Inter-Regular.ttf:inter_regular" "Inter-Medium.ttf:inter_medium" "Inter-SemiBold.ttf:inter_semibold")
  set(inputs "")
  foreach(face IN LISTS faces)
    string(REPLACE ":" ";" parts "${face}")
    list(GET parts 0 file)
    list(APPEND inputs "${font_dir}/${file}")
  endforeach()
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${inputs})

  set(stale FALSE)
  if(NOT EXISTS "${output}")
    set(stale TRUE)
  else()
    foreach(input IN LISTS inputs)
      if("${input}" IS_NEWER_THAN "${output}")
        set(stale TRUE)
      endif()
    endforeach()
  endif()
  if(NOT stale)
    return()
  endif()

  set(source "// Generated by cmake/EmbedFonts.cmake from assets/fonts. Do not edit.\n")
  string(APPEND source "// Inter (c) The Inter Project Authors, SIL Open Font License 1.1.\n")
  string(APPEND source "#include <cstddef>\nnamespace silta::detail {\n")
  foreach(face IN LISTS faces)
    string(REPLACE ":" ";" parts "${face}")
    list(GET parts 0 file)
    list(GET parts 1 symbol)
    file(READ "${font_dir}/${file}" hex HEX)
    string(LENGTH "${hex}" hex_length)
    math(EXPR size "${hex_length} / 2")
    # 0x.. bytes, 32 per line.
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(REGEX REPLACE "((0x..,){32})" "\\1\n" bytes "${bytes}")
    string(APPEND source "extern const unsigned char ${symbol}[];\n")
    string(APPEND source "extern const std::size_t ${symbol}_size;\n")
    string(APPEND source "alignas(4) const unsigned char ${symbol}[] = {\n${bytes}\n};\n")
    string(APPEND source "const std::size_t ${symbol}_size = ${size};\n")
  endforeach()
  string(APPEND source "} // namespace silta::detail\n")
  file(WRITE "${output}" "${source}")
endfunction()
